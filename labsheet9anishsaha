class Heap:
    def __init__(self, is_min=True):
        self.heap = []
        self.is_min = is_min

    def better(self, a, b):
        if self.is_min:
            return a < b
        return a > b

    def insert(self, value):
        self.heap.append(value)
        i = len(self.heap) - 1

        # Bubble up
        while i > 0:
            parent = (i - 1) // 2
            if self.better(self.heap[i], self.heap[parent]):
                self.heap[i], self.heap[parent] = (
                    self.heap[parent], self.heap[i])
                i = parent
            else:
                break

    def heapify_down(self, i):
        n = len(self.heap)

        while True:
            best = i
            left = 2 * i + 1
            right = 2 * i + 2

            if left < n and self.better(
                    self.heap[left], self.heap[best]):
                best = left

            if right < n and self.better(
                    self.heap[right], self.heap[best]):
                best = right

            if best == i:
                break

            self.heap[i], self.heap[best] = (
                self.heap[best], self.heap[i])
            i = best

    def extract_root(self):
        if not self.heap:
            print("Heap is empty")
            return None

        root = self.heap[0]
        last = self.heap.pop()

        if self.heap:
            self.heap[0] = last
            self.heapify_down(0)

        return root


values = [40, 10, 30, 50, 20]

min_heap = Heap(True)
max_heap = Heap(False)

for value in values:
    min_heap.insert(value)
    max_heap.insert(value)

print("Min Heap:", min_heap.heap)
print("Max Heap:", max_heap.heap)
print("Min Heap root:", min_heap.heap[0])
print("Max Heap root:", max_heap.heap[0])

