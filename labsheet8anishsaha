class BTreeNode:
    def __init__(self, leaf=True):
        self.keys = []
        self.children = []
        self.leaf = leaf


class BTree:
    def __init__(self):
        self.root = BTreeNode()

    def insert(self, key):
        root = self.root

        if len(root.keys) == 2:
            new_root = BTreeNode(False)
            new_root.children.append(root)
            self.split(new_root, 0)
            self.root = new_root

        self.add_nonfull(self.root, key)

    def split(self, parent, index):
        child = parent.children[index]
        right = BTreeNode(child.leaf)

        middle = child.keys[1]
        right.keys = child.keys[2:]
        child.keys = child.keys[:1]

        if not child.leaf:
            right.children = child.children[2:]
            child.children = child.children[:2]

        parent.keys.insert(index, middle)
        parent.children.insert(index + 1, right)

    def add_nonfull(self, node, key):
        if node.leaf:
            node.keys.append(key)
            node.keys.sort()
            return

        index = 0
        while index < len(node.keys) and key > node.keys[index]:
            index += 1

        if len(node.children[index].keys) == 2:
            self.split(node, index)
            if key > node.keys[index]:
                index += 1

        self.add_nonfull(node.children[index], key)

    def display(self, node=None):
        if node is None:
            node = self.root

        print(node.keys, end=" ")
        for child in node.children:
            self.display(child)


tree = BTree()

for value in [10, 20, 30, 40, 50]:
    tree.insert(value)

print("B-Tree nodes in traversal order:")
tree.display()
print()

