def evaluate_postfix(expression):
    stack = []

    for ch in expression:
        if ch == ' ':
            continue

        if ch.isdigit():
            stack.append(int(ch))

        else:
            if len(stack) < 2:
                print("Invalid expression")
                return None

            b = stack.pop()
            a = stack.pop()

            if ch == '+':
                stack.append(a + b)
            elif ch == '-':
                stack.append(a - b)
            elif ch == '*':
                stack.append(a * b)
            elif ch == '/':
                if b == 0:
                    print("Division by zero")
                    return None
                stack.append(int(a / b))
            elif ch == '%':
                stack.append(a % b)
            elif ch == '^':
                stack.append(a ** b)
            else:
                print("Invalid operator")
                return None

    if len(stack) != 1:
        print("Invalid expression")
        return None

    return stack.pop()


expression = "23*54*+"
print("Postfix Expression:", expression)
print("Result:", evaluate_postfix(expression))
