class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class Stack:
    def __init__(self):
        self.top = None

    def push(self, value):
        new_node = Node(value)
        new_node.next = self.top
        self.top = new_node
        print(value, "pushed")

    def pop(self):
        if self.top is None:
            print("Stack Underflow")
        else:
            print(self.top.data, "popped")
            self.top = self.top.next

    def display(self):
        temp = self.top
        if temp is None:
            print("Stack is empty")
            return

        print("Stack:", end=" ")
        while temp:
            print(temp.data, end=" ")
            temp = temp.next
        print()


s = Stack()
s.push(10)
s.push(20)
s.push(30)
s.display()
s.pop()
s.display()

