class Stack:
    def __init__(self, size):
        self.stack = [None] * size
        self.size = size
        self.top = -1

    def push(self, value):
        if self.top == self.size - 1:
            print("Stack Overflow")
        else:
            self.top += 1
            self.stack[self.top] = value
            print(value, "pushed")

    def pop(self):
        if self.top == -1:
            print("Stack Underflow")
        else:
            print(self.stack[self.top], "popped")
            self.stack[self.top] = None
            self.top -= 1

    def display(self):
        if self.top == -1:
            print("Stack is empty")
        else:
            print("Stack:", self.stack[:self.top + 1])


s = Stack(5)
s.push(10)
s.push(20)
s.push(30)
s.display()
s.pop()
s.display()

