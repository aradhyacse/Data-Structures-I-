import heapq

edges = [(1, 2, 1), (0, 1, 2),
         (0, 2, 3), (1, 3, 4), (2, 3, 5)]

# Kruskal's Algorithm
parent = list(range(4))

def find(x):
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]

mst = []
for u, v, w in sorted(edges, key=lambda e: e[2]):
    a, b = find(u), find(v)
    if a != b:
        parent[a] = b
        mst.append((u, v, w))

print("Kruskal MST:", mst)
print("Total Cost:", sum(w for u, v, w in mst))

# Prim's Algorithm
graph = {
    0: [(1, 2), (2, 3)],
    1: [(0, 2), (2, 1), (3, 4)],
    2: [(0, 3), (1, 1), (3, 5)],
    3: [(1, 4), (2, 5)]
}

visited = {0}
heap = [(w, 0, v) for v, w in graph[0]]
heapq.heapify(heap)
cost = 0

while heap and len(visited) < 4:
    w, u, v = heapq.heappop(heap)
    if v not in visited:
        visited.add(v)
        cost += w
        for n, weight in graph[v]:
            if n not in visited:
                heapq.heappush(heap, (weight, v, n))

print("Prim MST Cost:", cost)
