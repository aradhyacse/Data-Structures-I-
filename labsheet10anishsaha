# Open Hashing (Chaining)
table = [[] for _ in range(5)]

for x in [10, 15, 20, 25]:
    table[x % 5].append(x)

print("Open Hashing:", table)

# Closed Hashing (Linear Probing)
table = [None] * 5

for x in [10, 15, 20, 25]:
    i = x % 5
    while table[i] is not None:
        i = (i + 1) % 5
    table[i] = x

print("Closed Hashing:", table)

