from collections import deque

graph = {
    0: [1, 2],
    1: [0, 3],
    2: [0, 3],
    3: [1, 2]
}

def dfs(v, visited):
    if v not in visited:
        print(v, end=" ")
        visited.add(v)
        for n in graph[v]:
            dfs(n, visited)

def bfs(start):
    visited = {start}
    q = deque([start])

    while q:
        v = q.popleft()
        print(v, end=" ")
        for n in graph[v]:
            if n not in visited:
                visited.add(n)
                q.append(n)

print("DFS:")
dfs(0, set())
print("\nBFS:")
bfs(0)

