class DNode:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class DLL:
    def __init__(self):
        self.head = None

    def insert(self, data):
        node = DNode(data)

        if not self.head:
            self.head = node
            return

        cur = self.head
        while cur.next:
            cur = cur.next

        cur.next = node
        node.prev = cur

    def delete(self, key):
        cur = self.head

        while cur and cur.data != key:
            cur = cur.next

        if not cur:
            return

        if cur.prev:
            cur.prev.next = cur.next
        else:
            self.head = cur.next

        if cur.next:
            cur.next.prev = cur.prev

    def reverse_display(self):
        cur = self.head

        if not cur:
            print("List is empty")
            return

        while cur.next:
            cur = cur.next

        while cur:
            print(cur.data, end=" <-> ")
            cur = cur.prev

        print("None")

d = DLL()

for x in [10, 20, 30]:
    d.insert(x)

