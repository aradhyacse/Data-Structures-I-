import heapq

def optimal_merge(files):
    heapq.heapify(files)
    total_cost = 0

    while len(files) > 1:
        first = heapq.heappop(files)
        second = heapq.heappop(files)

        merged = first + second
        total_cost += merged

        print("Merging", first, "and", second,
              "=", merged)

        heapq.heappush(files, merged)

    print("Minimum Total Merge Cost:", total_cost)


file_sizes = [20, 30, 10, 5]
optimal_merge(file_sizes)
